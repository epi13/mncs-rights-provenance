{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mncs.dev/schemas/rights-provenance/agent-context/v0.1.0.schema.json",
  "title": "MNCS Rights and Provenance Agent Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "context_budget_bytes", "identity", "status", "sources", "rights", "provenance", "governance", "diagnostics"],
  "properties": {
    "schema_version": {"const": "mncs.rights-provenance.agent-context/1"},
    "context_budget_bytes": {"type": "integer", "minimum": 4096, "maximum": 8192},
    "identity": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "status": {"enum": ["declared", "review"]},
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rights_manifest", "governance_profile", "license_resolver", "license_action_ruleset"],
      "properties": {
        "rights_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "sha256", "manifest_identity", "identity_state"],
          "properties": {
            "reference": {"type": "string", "minLength": 1, "maxLength": 256},
            "sha256": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
            "manifest_identity": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
            "identity_state": {"enum": ["verified-content-digest", "computed-from-observed-content"]}
          }
        },
        "governance_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "sha256"],
          "properties": {
            "reference": {"type": "string", "minLength": 1, "maxLength": 256},
            "sha256": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"}
          }
        },
        "license_candidate_registry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "sha256"],
          "properties": {
            "reference": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          }
        },
        "license_resolver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "sha256"],
          "properties": {
            "reference": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          }
        },
        "license_action_ruleset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "sha256"],
          "properties": {
            "reference": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution_license", "declaration_state", "copyright_status", "rights_basis", "third_party_material", "sources", "source_count", "sources_truncated", "license_terms", "license_terms_access", "action_guidance", "compatibility"],
      "properties": {
        "distribution_license": {"type": ["string", "null"], "maxLength": 256},
        "declaration_state": {"enum": ["declared", "unknown"]},
        "copyright_status": {"type": "string", "minLength": 1, "maxLength": 128},
        "rights_basis": {"type": "string", "minLength": 1, "maxLength": 128},
        "third_party_material": {"type": "string", "minLength": 1, "maxLength": 128},
        "sources": {
          "type": "array",
          "items": {"$ref": "#/$defs/rights_source_summary"},
          "maxItems": 4
        },
        "source_count": {"type": "integer", "minimum": 0},
        "sources_truncated": {"type": "boolean"},
        "license_terms": {"$ref": "#/$defs/license_terms_projection"},
        "distribution_license_truncated": {"type": "boolean"},
        "license_terms_access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["query_ref"],
          "properties": {
            "query_ref": {"const": "mncs-rp license-resolve"}
          }
        },
        "action_guidance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "status", "expression_ref", "expression_evidence", "query_ref", "legal_conclusion"],
          "properties": {
            "schema_version": {"const": "mncs.rights.license-action-context/1"},
            "status": {"enum": ["reference-summary", "partial", "unresolved"]},
            "expression_ref": {"type": "string", "minLength": 1, "maxLength": 256},
            "expression_evidence": {"enum": ["declared-unverified", "no-usable-declaration"]},
            "query_ref": {"const": "mncs-rp action-guidance"},
            "ruleset": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version"],
              "properties": {
                "version": {"const": "mncs.rights.license-action-rules/1"},
                "module": {"const": "mncs.rights.license_actions.v01"},
                "module_ref": {"type": "string", "minLength": 1},
                "identity": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
                "source": {"const": "#/sources/license_action_ruleset"}
              }
            },
            "expression_tree": {
              "oneOf": [
                {"type": "null"},
                {"$ref": "#/$defs/action_tree"}
              ]
            },
            "expression_tree_ref": {"type": "string", "minLength": 1, "maxLength": 256},
            "actions": {
              "type": "object",
              "additionalProperties": false,
              "required": ["redistribute-source", "redistribute-binary"],
              "properties": {
                "redistribute-source": {"$ref": "#/$defs/action_result"},
                "redistribute-binary": {"$ref": "#/$defs/action_result"}
              }
            },
            "unresolved_action_counts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["redistribute-source", "redistribute-binary"],
              "properties": {
                "redistribute-source": {"$ref": "#/$defs/unresolved_counts"},
                "redistribute-binary": {"$ref": "#/$defs/unresolved_counts"}
              }
            },
            "decision_notes": {"type": "array", "items": {"type": "string", "maxLength": 256}, "maxItems": 4},
            "decision_note_count": {"type": "integer", "minimum": 0},
            "decision_notes_truncated": {"type": "boolean"},
            "not_assessed": {"type": "array", "items": {"type": "string", "maxLength": 128}, "maxItems": 4},
            "legal_conclusion": {"const": "NOT_MADE"}
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {"const": "unknown"},
            "reason": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_classification", "evidence_state", "participant_count", "relationship_count", "relationship_kinds", "detail_ref", "projection"],
      "properties": {
        "origin_classification": {"type": "string", "minLength": 1, "maxLength": 128},
        "evidence_state": {"const": "declared-unverified"},
        "participant_count": {"type": "integer", "minimum": 0},
        "relationship_count": {"type": "integer", "minimum": 0},
        "relationship_kinds": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "detail_ref": {"type": "string", "minLength": 1, "maxLength": 320},
        "projection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "output_ref", "relationships"],
          "properties": {
            "schema_version": {"const": "mncs.rights-provenance.context-lineage/1"},
            "output_ref": {"type": "string", "minLength": 1, "maxLength": 64},
            "relationships": {
              "type": "array", "maxItems": 6,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["from", "relation", "evidence_state"],
                "anyOf": [
                  {"required": ["content_digest"]},
                  {"required": ["content_digest_ref"]}
                ],
                "properties": {
                  "from": {"type": "string", "minLength": 1, "maxLength": 320},
                  "to": {"type": "string", "minLength": 1, "maxLength": 128},
                  "relation": {"enum": ["generated-from", "transformed-by", "referenced"]},
                  "content_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
                  "content_digest_ref": {"type": "string", "pattern": "^#/sources/[a-z_]+/sha256$"},
                  "evidence_state": {"enum": ["observed-input", "observed-execution", "unavailable"]}
                }
              }
            }
          }
        }
      }
    },
    "governance": {"$ref": "#/$defs/governance_projection"},
    "diagnostics": {
      "type": "array",
      "maxItems": 12,
      "items": {"$ref": "#/$defs/context_diagnostic"}
    }
  },
  "$defs": {
    "rights_source_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "license", "license_status_declared", "verification_state", "license_terms_status", "license_terms_ref", "evidence_refs"],
      "properties": {
        "kind": {"type": "string", "minLength": 1, "maxLength": 64},
        "reference": {"type": "string", "minLength": 1, "maxLength": 160},
        "license": {"type": ["string", "null"], "maxLength": 128},
        "license_status_declared": {"type": "string", "minLength": 1, "maxLength": 64},
        "verification_state": {"const": "unverified"},
        "license_terms_status": {"enum": ["reference-summary", "partial", "unresolved"]},
        "license_terms_ref": {"type": "string", "minLength": 1, "maxLength": 400},
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string", "maxLength": 160},
          "maxItems": 2
        }
      }
    },
    "governance_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rights", "provenance", "agent_governance"],
      "properties": {
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["external_material", "incompatible_rights", "unknown_rights"],
          "properties": {
            "external_material": {"enum": ["verify", "record-source"]},
            "incompatible_rights": {"enum": ["resolve-before-inclusion", "explain-and-escalate"]},
            "unknown_rights": {"enum": ["investigate", "preserve-unknown"]}
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lineage", "transformations", "external_inputs", "unverifiable_claims"],
          "properties": {
            "lineage": {"enum": ["preserve", "best-effort"]},
            "transformations": {"enum": ["record", "best-effort"]},
            "external_inputs": {"enum": ["identify", "best-effort"]},
            "unverifiable_claims": {"enum": ["distinguish", "record"]}
          }
        },
        "agent_governance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["copying_external_implementations", "independent_implementation", "rights_conflict", "provenance_loss"],
          "properties": {
            "copying_external_implementations": {"enum": ["authorization-required", "verify-rights"]},
            "independent_implementation": {"enum": ["permitted-when-lawful", "investigate"]},
            "rights_conflict": {"enum": ["explain-and-escalate", "investigate"]},
            "provenance_loss": {"enum": ["diagnose-and-recover", "record-unknown"]}
          }
        }
      }
    },
    "governance_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "basis", "source_ref", "scope"],
      "properties": {
        "issuer": {"type": "string", "minLength": 1, "maxLength": 120},
        "basis": {"type": "string", "minLength": 1, "maxLength": 120},
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "scope": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 120},
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        }
      }
    },
    "governance_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "profile_id", "profile_version", "authority"],
      "properties": {
        "status": {"enum": ["authorized", "unavailable"]},
        "profile_id": {"type": ["string", "null"], "maxLength": 160},
        "profile_version": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535},
        "authority": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/governance_authority"}
          ]
        },
        "rules": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/governance_rules"}
          ]
        },
        "detail_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "rules_ref": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "oneOf": [
        {"required": ["detail_ref"]},
        {"required": ["rules_ref"]}
      ],
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "authorized"}}, "required": ["status"]},
          "then": {
            "properties": {
              "profile_id": {"type": "string", "minLength": 1},
              "profile_version": {"type": "integer", "minimum": 1},
              "authority": {"$ref": "#/$defs/governance_authority"}
            },
            "anyOf": [
              {"properties": {"rules": {"$ref": "#/$defs/governance_rules"}}, "required": ["rules"]},
              {"required": ["rules_ref"]}
            ]
          }
        },
        {
          "if": {"properties": {"status": {"const": "unavailable"}}, "required": ["status"]},
          "then": {
            "properties": {
              "profile_id": {"type": "null"},
              "profile_version": {"type": "null"},
              "authority": {"type": "null"},
              "rules": {"type": "null"}
            },
            "required": ["profile_id", "profile_version", "authority", "rules"]
          }
        }
      ]
    },
    "context_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "summary", "evidence_ref", "remedy"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 128},
        "severity": {"const": "review"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1024},
        "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 512},
        "remedy": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "license_terms_projection": {
      "type": "object",
      "required": ["schema_version", "expression_evidence", "status", "compatibility"],
      "properties": {
        "schema_version": {"const": "mncs.rights.license-resolution/4"},
        "expression_evidence": {
          "enum": ["caller-supplied-declaration-unverified", "no-usable-declaration"]
        },
        "expression": {"type": ["string", "null"], "maxLength": 4096},
        "status": {"enum": ["unresolved", "partial", "reference-summary"]},
        "reason": {"type": "string", "minLength": 1},
        "expression_tree": {"$ref": "#/$defs/license_terms_expression_node"},
        "unresolved_identifiers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 4096},
          "uniqueItems": true,
          "maxItems": 256
        },
        "candidate_references": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "maxItems": 128
        },
        "candidate_registry": {"$ref": "#/$defs/license_terms_content_reference"},
        "candidate_review_details": {
          "type": "array",
          "items": {"$ref": "#/$defs/license_terms_candidate_review_detail"},
          "uniqueItems": true,
          "maxItems": 128
        },
        "compatibility": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {"const": "unknown"},
            "reason": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "detail_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
        "expression_truncated": {"type": "boolean"},
        "unresolved_identifier_count": {"type": "integer", "minimum": 0},
        "unresolved_identifiers_ref": {"type": "string", "minLength": 1, "maxLength": 1024}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "unresolved"}}, "required": ["status"]},
          "then": {"required": ["reason"]}
        },
        {
          "if": {
            "properties": {"status": {"enum": ["partial", "reference-summary"]}},
            "required": ["status"]
          },
          "then": {
            "required": ["candidate_references"],
            "anyOf": [
              {"required": ["unresolved_identifiers"]},
              {"required": ["unresolved_identifier_count", "unresolved_identifiers_ref"]}
            ],
            "not": {"required": ["reason"]}
          }
        },
        {
          "if": {
            "properties": {"expression_evidence": {"const": "no-usable-declaration"}},
            "required": ["expression_evidence"]
          },
          "then": {
            "properties": {
              "expression": {"type": "null"},
              "status": {"const": "unresolved"}
            },
            "required": ["expression", "status"]
          }
        }
      ],
      "additionalProperties": false
    },
    "license_terms_content_reference": {
      "type": "object",
      "required": ["reference", "sha256"],
      "properties": {
        "reference": {"type": "string", "minLength": 1, "maxLength": 512},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "license_terms_candidate_review_detail": {
      "type": "object",
      "required": ["license", "status", "decision_count", "decisions_ref"],
      "properties": {
        "license": {"type": "string", "minLength": 1, "maxLength": 512},
        "status": {"type": "string", "minLength": 1, "maxLength": 128},
        "decision_count": {"type": "integer", "minimum": 0},
        "decisions_ref": {"type": "string", "minLength": 1, "maxLength": 1024}
      },
      "additionalProperties": false
    },
    "license_terms_expression_node": {
      "oneOf": [
        {
          "type": "object",
          "required": ["operator", "terms"],
          "properties": {
            "operator": {"enum": ["AND", "OR"]},
            "terms": {
              "type": "array",
              "minItems": 2,
              "maxItems": 256,
              "items": {"$ref": "#/$defs/license_terms_expression_node"}
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["license", "status"],
          "properties": {
            "license": {"type": "string", "minLength": 1, "maxLength": 4096},
            "status": {
              "enum": [
                "reference-summary",
                "candidate-unapproved",
                "unresolved-license-reference",
                "unknown-license-terms",
                "unknown-license-exception-terms"
              ]
            },
            "exception": {"type": "string", "minLength": 1, "maxLength": 256},
            "reason": {"type": "string", "minLength": 1, "maxLength": 512},
            "reference_kind": {"type": "string", "minLength": 1, "maxLength": 128},
            "candidate_status": {"type": "string", "minLength": 1, "maxLength": 128},
            "candidate_version": {"type": "string", "minLength": 1, "maxLength": 128},
            "effective_grant": {"type": "boolean"},
            "adoption_status": {"type": "string", "minLength": 1, "maxLength": 128},
            "declared_rights_prove_authority": {"type": "boolean"},
            "source_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
            "registry_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
            "registry_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "permissions": {
              "type": "array",
              "items": {"type": "string", "minLength": 1, "maxLength": 256},
              "uniqueItems": true,
              "maxItems": 64
            },
            "conditions": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "required": ["id", "when"],
                "properties": {
                  "id": {"type": "string", "minLength": 1, "maxLength": 256},
                  "when": {"type": "string", "minLength": 1, "maxLength": 512}
                },
                "additionalProperties": false
              }
            },
            "patent": {
              "type": "object",
              "required": ["status"],
              "properties": {
                "status": {"type": "string", "minLength": 1, "maxLength": 256},
                "scope": {"type": "string", "maxLength": 1024},
                "termination": {"type": "string", "maxLength": 512}
              },
              "additionalProperties": false
            },
            "source": {"type": "string", "minLength": 1, "maxLength": 1024},
            "warranty": {"type": "string", "minLength": 1, "maxLength": 512}
          },
          "additionalProperties": false
        }
      ]
    },
    "action_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["reference-summary", "partial", "unresolved"]},
        "unresolved_identifiers": {"type": "array", "items": {"type": "string", "maxLength": 128}, "maxItems": 8},
        "unresolved_identifier_count": {"type": "integer", "minimum": 0},
        "unresolved_conditions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "license": {"type": "string", "maxLength": 128},
              "condition": {"type": "string", "maxLength": 128},
              "reason": {"type": "string", "maxLength": 128}
            }
          }
        },
        "unresolved_condition_count": {"type": "integer", "minimum": 0},
        "decision_notes": {"type": "array", "items": {"type": "string", "maxLength": 256}, "maxItems": 4},
        "decision_note_count": {"type": "integer", "minimum": 0},
        "unresolved_identifiers_truncated": {"type": "boolean"},
        "unresolved_conditions_truncated": {"type": "boolean"},
        "decision_notes_truncated": {"type": "boolean"}
      }
    },
    "unresolved_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifiers", "conditions"],
      "properties": {
        "identifiers": {"type": "integer", "minimum": 0},
        "conditions": {"type": "integer", "minimum": 0}
      }
    },
    "action_tree": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {"required": ["operator", "terms"]},
        {"required": ["license", "status"]}
      ],
      "properties": {
        "operator": {"enum": ["AND", "OR"]},
        "terms": {"type": "array", "items": {"$ref": "#/$defs/action_tree"}, "maxItems": 256},
        "license": {"type": "string", "maxLength": 128},
        "license_truncated": {"type": "boolean"},
        "exception": {"type": "string", "maxLength": 128},
        "status": {"type": "string", "maxLength": 64},
        "reason": {"type": "string", "maxLength": 256},
        "reference_kind": {"type": "string", "maxLength": 64},
        "candidate_status": {"type": "string", "maxLength": 64},
        "candidate_version": {"type": "string", "maxLength": 64},
        "effective_grant": {"type": ["boolean", "null"]},
        "adoption_status": {"type": "string", "maxLength": 64},
        "conditions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "when", "guidance", "action_relations"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "maxLength": 128},
              "when": {"type": "string", "maxLength": 256},
              "guidance": {"type": "string", "maxLength": 256},
              "action_relations": {
                "type": "object",
                "additionalProperties": false,
                "required": ["redistribute-source", "redistribute-binary"],
                "properties": {
                  "redistribute-source": {"enum": ["operation-class-matches-trigger", "other-trigger-preserved-for-review", "unclassified-condition"]},
                  "redistribute-binary": {"enum": ["operation-class-matches-trigger", "other-trigger-preserved-for-review", "unclassified-condition"]}
                }
              }
            }
          }
        }
      }
    }
  }
}
