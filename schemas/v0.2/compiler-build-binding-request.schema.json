{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mncs.dev/schemas/rights-provenance/compiler-build-binding-request/0.2.0.schema.json",
  "title": "MNCS Compiler build binding request 0.2.0",
  "description": "A bounded request to project Compiler application-build/4, /7, or /11 identities and declared lineage into a Rights artifact binding. An optional canonical Environment Store reference records direct observation of the response record. This does not verify the Compiler producer or make a legal conclusion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "application_build"],
  "properties": {
    "schema_version": {
      "const": "mncs.rights-provenance.compiler-build-binding-request/0.2.0"
    },
    "application_build": {
      "type": "object",
      "required": ["schema_version", "status", "source_snapshot", "dependency_graph", "producer", "artifact"],
      "properties": {
        "schema_version": {
          "enum": [
            "mncs.compiler.application-build/4",
            "mncs.compiler.application-build/7",
            "mncs.compiler.application-build/11"
          ]
        },
        "status": {"const": "verified"},
        "source_snapshot": {
          "type": "object",
          "required": ["identity", "files"],
          "properties": {
            "identity": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 65,
              "items": {
                "type": "object",
                "required": ["module", "source_id", "sha256"],
                "properties": {
                  "module": {"type": "string", "minLength": 1, "maxLength": 128},
                  "source_id": {"type": "string", "minLength": 1, "maxLength": 256},
                  "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
                }
              }
            }
          }
        },
        "dependency_graph": {
          "type": "object",
          "required": ["identity"],
          "properties": {
            "identity": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          }
        },
        "producer": {"type": "object"},
        "artifact": {
          "type": "object",
          "required": ["identity", "value"],
          "properties": {
            "identity": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "value": {
              "type": "object",
              "required": ["artifact_id", "source"],
              "properties": {
                "artifact_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
                "source": {
                  "type": "object",
                  "required": ["lowering_refs"],
                  "properties": {
                    "lowering_refs": {
                      "type": "array",
                      "maxItems": 64,
                      "items": {"type": "string", "maxLength": 512}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "contributing_manifests": {
      "type": "array",
      "maxItems": 64,
      "items": {"type": "object"},
      "description": "Explicit Rights manifest references for build inputs. External license metadata is not elevated into policy."
    },
    "context_identity": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "store_ref": {
      "type": "string",
      "minLength": 11,
      "maxLength": 1024,
      "pattern": "^mncs-store:[^\\u0000-\\u001f\\u007f]+$",
      "description": "Canonical Environment Store reference for the Compiler response; recorded as directly observed record evidence."
    }
  }
}
