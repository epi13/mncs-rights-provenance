{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mncs.dev/schemas/rights-provenance/native-artifact-binding-diagnostic/v0.2.0.schema.json",
  "title": "MNCS native artifact binding diagnostic 0.2.0",
  "description": "Bounded findings about declared rights or lineage state. No findings is not a compliance result and no legal conclusion is made.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "artifact_identity", "diagnostics", "legal_conclusion"],
  "properties": {
    "schema_version": {
      "const": "mncs.rights-provenance.artifact-binding-diagnostic/0.2.0"
    },
    "status": {"enum": ["review", "no-findings"]},
    "artifact_identity": {"type": "string", "minLength": 1, "maxLength": 512},
    "diagnostics": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "summary", "evidence_ref", "remedy"],
        "properties": {
          "code": {
            "enum": [
              "artifact-rights-manifests-missing",
              "artifact-rights-unknown",
              "artifact-rights-unresolved",
              "artifact-rights-state-conflict",
              "artifact-rights-manifest-reference-inconsistent",
              "artifact-rights-compatibility-unknown",
              "artifact-lineage-missing",
              "artifact-lineage-evidence-unavailable",
              "artifact-lineage-state-conflict",
              "artifact-lineage-completeness-unsubstantiated"
            ]
          },
          "severity": {"const": "review"},
          "summary": {"type": "string", "minLength": 1, "maxLength": 512},
          "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
          "evidence_refs": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "pattern": "^#/rights/contributing_manifests/[0-9]+$"
            }
          },
          "conflicting_fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "enum": [
                "manifest_digest",
                "manifest_identity",
                "evidence_state",
                "rights_state",
                "license_expression_ref",
                "obligations_ref"
              ]
            }
          },
          "conflict_count": {"type": "integer", "minimum": 1, "maximum": 64},
          "remedy": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    "legal_conclusion": {"const": "NOT_MADE"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "diagnostics": {
            "contains": {
              "properties": {
                "code": {"const": "artifact-rights-manifest-reference-inconsistent"}
              },
              "required": ["code"]
            }
          }
        },
        "required": ["diagnostics"]
      },
      "then": {
        "properties": {
          "diagnostics": {
            "items": {
              "if": {
                "properties": {
                  "code": {"const": "artifact-rights-manifest-reference-inconsistent"}
                },
                "required": ["code"]
              },
              "then": {
                "required": ["evidence_refs", "conflicting_fields", "conflict_count"]
              }
            }
          }
        }
      }
    }
  ]
}
