{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mncs.dev/schemas/rights-provenance/license-candidate-registry/v0.2.0.schema.json",
  "title": "MNCS Rights License Candidate Registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "mncs.rights.license-candidates/2"
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "version",
        "status",
        "adoption_status",
        "effective_grant",
        "retroactive_application",
        "adoption_authority",
        "text_ref",
        "text_sha256",
        "declared_rights_prove_authority",
        "legal_review_decisions"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "pattern": "^LicenseRef-[A-Za-z0-9.+-]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "status": {
          "const": "draft-for-legal-review"
        },
        "adoption_status": {
          "const": "not-adopted"
        },
        "effective_grant": {
          "const": false
        },
        "retroactive_application": {
          "const": false
        },
        "adoption_authority": {
          "type": "null"
        },
        "text_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "declared_rights_prove_authority": {
          "const": false
        },
        "legal_review_decisions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "uniqueItems": true
        }
      }
    }
  }
}
