mncs 0.18;

// MNCS Rights & Provenance - normative agent-governance profile vocabulary.
//
// This core decides whether a versioned profile value is in the bounded
// operational vocabulary for its field. `Supported` means the profile may
// give that guidance to agents under separately established Environment
// authority. It grants no legal right, does not establish that a declaration
// is accurate, and does not make external metadata authoritative. Unknown or
// mismatched pairs stay reviewable rather than defaulting to permission.

module mncs.rights.agent_governance.v01;

enum GovernanceField {
    ExternalMaterial,
    IncompatibleRights,
    UnknownRights,
    Lineage,
    Transformations,
    ExternalInputs,
    UnverifiableClaims,
    CopyingExternalImplementations,
    IndependentImplementation,
    RightsConflict,
    ProvenanceLoss,
}

enum GovernanceValue {
    Verify,
    RecordSource,
    ResolveBeforeInclusion,
    ExplainAndEscalate,
    Investigate,
    PreserveUnknown,
    Preserve,
    BestEffort,
    Record,
    Identify,
    Distinguish,
    AuthorizationRequired,
    VerifyRights,
    PermittedWhenLawful,
    DiagnoseAndRecover,
    RecordUnknown,
}

enum GovernanceDecision { Supported, NeedsReview }

// Discriminants and accepted field/value pairs are pinned by the execution
// corpus. Other combinations return NeedsReview, including future values until
// this versioned core explicitly admits them.
fn governance_field_code(field: GovernanceField) -> (result: u64) {
    return match field {
        GovernanceField.ExternalMaterial => 0,
        GovernanceField.IncompatibleRights => 1,
        GovernanceField.UnknownRights => 2,
        GovernanceField.Lineage => 3,
        GovernanceField.Transformations => 4,
        GovernanceField.ExternalInputs => 5,
        GovernanceField.UnverifiableClaims => 6,
        GovernanceField.CopyingExternalImplementations => 7,
        GovernanceField.IndependentImplementation => 8,
        GovernanceField.RightsConflict => 9,
        GovernanceField.ProvenanceLoss => 10,
    };
}

fn governance_value_code(value: GovernanceValue) -> (result: u64) {
    return match value {
        GovernanceValue.Verify => 0,
        GovernanceValue.RecordSource => 1,
        GovernanceValue.ResolveBeforeInclusion => 2,
        GovernanceValue.ExplainAndEscalate => 3,
        GovernanceValue.Investigate => 4,
        GovernanceValue.PreserveUnknown => 5,
        GovernanceValue.Preserve => 6,
        GovernanceValue.BestEffort => 7,
        GovernanceValue.Record => 8,
        GovernanceValue.Identify => 9,
        GovernanceValue.Distinguish => 10,
        GovernanceValue.AuthorizationRequired => 11,
        GovernanceValue.VerifyRights => 12,
        GovernanceValue.PermittedWhenLawful => 13,
        GovernanceValue.DiagnoseAndRecover => 14,
        GovernanceValue.RecordUnknown => 15,
    };
}

fn guidance_decision(field: GovernanceField, value: GovernanceValue) -> (result: GovernanceDecision) {
    return match field {
        GovernanceField.ExternalMaterial => match value {
            GovernanceValue.Verify => GovernanceDecision.Supported,
            GovernanceValue.RecordSource => GovernanceDecision.Supported,
            GovernanceValue.ResolveBeforeInclusion => GovernanceDecision.NeedsReview,
            GovernanceValue.ExplainAndEscalate => GovernanceDecision.NeedsReview,
            GovernanceValue.Investigate => GovernanceDecision.NeedsReview,
            GovernanceValue.PreserveUnknown => GovernanceDecision.NeedsReview,
            GovernanceValue.Preserve => GovernanceDecision.NeedsReview,
            GovernanceValue.BestEffort => GovernanceDecision.NeedsReview,
            GovernanceValue.Record => GovernanceDecision.NeedsReview,
            GovernanceValue.Identify => GovernanceDecision.NeedsReview,
            GovernanceValue.Distinguish => GovernanceDecision.NeedsReview,
            GovernanceValue.AuthorizationRequired => GovernanceDecision.NeedsReview,
            GovernanceValue.VerifyRights => GovernanceDecision.NeedsReview,
            GovernanceValue.PermittedWhenLawful => GovernanceDecision.NeedsReview,
            GovernanceValue.DiagnoseAndRecover => GovernanceDecision.NeedsReview,
            GovernanceValue.RecordUnknown => GovernanceDecision.NeedsReview,
        },
        GovernanceField.IncompatibleRights => match value {
            GovernanceValue.Verify => GovernanceDecision.NeedsReview,
            GovernanceValue.RecordSource => GovernanceDecision.NeedsReview,
            GovernanceValue.ResolveBeforeInclusion => GovernanceDecision.Supported,
